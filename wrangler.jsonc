{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genzui",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build/release",
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "routes": [{ "pattern": "genzui.mkpo.li", "custom_domain": true }]
}
